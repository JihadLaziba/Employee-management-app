# Copier ce fichier en ".env" avant de lancer : cp .env.example .env

# ---------- PostgreSQL ----------
POSTGRES_DB=ems_db
POSTGRES_USER=ems_user
POSTGRES_PASSWORD=ems_password

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=employees

# ---------- JWT ----------
# Au moins 32 caractères (256 bits) pour HS256
JWT_SECRET=change-me-this-is-a-very-long-secret-key-for-jwt-signing-2026
JWT_EXPIRATION_MS=86400000

# ---------- Les 2 Super Administrateurs créés au démarrage ----------
SUPERADMIN1_NAME=Super Admin One
SUPERADMIN1_EMAIL=admin1@ems.com
SUPERADMIN1_PASSWORD=Admin@123

SUPERADMIN2_NAME=Super Admin Two
SUPERADMIN2_EMAIL=admin2@ems.com
SUPERADMIN2_PASSWORD=Admin@123
